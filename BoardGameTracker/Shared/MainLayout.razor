@inherits LayoutComponentBase

<PageTitle>BoardGameTracker</PageTitle>

<div class="page">
    <AuthorizeView>
        <Authorized>
            <!-- Show full layout with navigation for authenticated users -->
            <div class="sidebar">
                <NavMenu />
            </div>
            <main>
                <div class="top-row px-4">
                    <a href="https://docs.microsoft.com/aspnet/" target="_blank">About</a>
                </div>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </Authorized>
        <NotAuthorized>
            <!-- Show minimal layout for unauthenticated users -->
            <main>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </NotAuthorized>
    </AuthorizeView>
</div>
