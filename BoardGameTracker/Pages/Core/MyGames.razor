@page "/mygames"
@inject NavigationManager Navigation
@inject IGameService GameService
@inject IJSRuntime JSRuntime
@using BoardGameTracker.Models
@using BoardGameTracker.Data
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3>My Games</h3>
                    <button class="btn btn-primary" @onclick="NavigateToAddGame">
                        <i class="fas fa-plus"></i> Add New Game
                    </button>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p>Loading your games...</p>
                        </div>
                    }
                    else if (games == null || !games.Any())
                    {
                        <div class="text-center">
                            <p>You don't have any games yet.</p>
                            <button class="btn btn-primary" @onclick="NavigateToAddGame">
                                Add Your First Game
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var game in games)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card">
                                        <div class="card-body">
                                            <h5 class="card-title">@game.Name</h5>
                                            <p class="card-text">
                                                <small class="text-muted">
                                                    Owner: @game.Owner<br/>
                                                    Added: @game.CreatedDate.ToString("MMM dd, yyyy")
                                                </small>
                                            </p>
                                            <div class="btn-group" role="group">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditGame(game.Id)">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteGame(game.Id)">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-3">
                            <p class="text-muted">Total games: @games.Count()</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code 
{
    private IEnumerable<Game>? games;
    private bool isLoading = true;
    private string currentUser = "Eddie"; // TODO: Replace with authenticated user

    protected override async Task OnInitializedAsync()
    {
        await LoadGames();
    }

    private async Task LoadGames()
    {
        try
        {
            isLoading = true;
            
            // This goes to VS Code terminal
            Console.WriteLine($"Loading games for user: {currentUser}");
            
            // This goes to browser F12 console
            await JSRuntime.InvokeVoidAsync("console.log", $"Loading games for user: {currentUser}");
            
            games = await GameService.GetByOwnerAsync(currentUser);
            
            // Browser console logging
            await JSRuntime.InvokeVoidAsync("console.log", $"Found {games.Count()} games");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading games: {ex.Message}"); // Server console
            await JSRuntime.InvokeVoidAsync("console.error", $"Error loading games: {ex.Message}"); // Browser console
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToAddGame()
    {
        Navigation.NavigateTo("/addgame");
    }

    private void EditGame(int gameId)
    {
        Navigation.NavigateTo($"/editgame/{gameId}");
    }

    private async Task DeleteGame(int gameId)
    {
        // TODO: Add confirmation dialog
        try
        {
            await GameService.DeleteAsync(gameId);
            await LoadGames(); // Refresh the list
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting game: {ex.Message}");
        }
    }
}