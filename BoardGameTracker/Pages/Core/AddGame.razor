@page "/addgame"
@inject NavigationManager Navigation

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header text-center">
                    <h3>Add a New Game</h3>
                </div>
                <div class="card-body text-center">
                    <p>Please fill in the details to add a new game.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void LoginUser()
    {
        Navigation.NavigateTo($"/authentication/challenge?returnUrl={Uri.EscapeDataString("/")}", true);
    }
}