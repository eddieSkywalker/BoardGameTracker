@page "/internal/warehouse-dashboard"
@using Microsoft.AspNetCore.Components.Forms

<h3>Warehouse Dashboard</h3>

<h5>Temp data for recent orders</h5>

<table border="1" style="width:50%; text-align:left;">
    <tr>
        <th>Order Name</th>
        <th>Temp Data</th>
    </tr>
    <tr>
        <td>Order001</td>
        <td>72°F</td>
    </tr>
    <tr>
        <td>Order002</td>
        <td>68°F</td>
    </tr>
</table>

<br />
<br />

<h5>Add</h5>

<EditForm Model="@order" OnValidSubmit="HandleValidSubmit">
    <InputText @bind-Value="order.Name" placeholder="Order Name" />
    <br />
    <InputTextArea @bind-Value="order.TempData" placeholder="Temp Data" />
    <br />
    <button type="submit">Submit</button>
</EditForm>

@code 
{
    private Order order = new();

    private void HandleValidSubmit()
    {
        // Save to DB (hook up later)
        Console.WriteLine($"Order created: {order.Name}");
    }

    class Order
    {
        public string Name { get; set; }
        public string TempData { get; set; }
    }
}